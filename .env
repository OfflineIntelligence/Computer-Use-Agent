##################################################### Rust Server Configuration
RUST_SERVER_URL=http://127.0.0.1:8000
RUST_SERVER_MODEL=your-model-name
RUST_SERVER_TIMEOUT=600
RUST_SERVER_MAX_TOKENS=4096

##################################################### Model Performance Parameters
MODEL_CONTEXT_SIZE=2048
MODEL_BATCH_SIZE=256
MODEL_THREADS=6
MODEL_GPU_LAYERS=66

##################################################### Agent Memory Configuration
AGENT_TRAJECTORY_MAXLEN=12
AGENT_ENABLE_REFLECTION=true
AGENT_TEMPERATURE=0.5

##################################################### Execution Configuration
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=1.0

##################################################### OCR Configuration
TESSERACT_PATH=D:\modelhouse\Tesseract Engine\tesseract.exe
TESSERACT_CONFIDENCE_THRESHOLD=30

##################################################### Safety & UI Configuration
AGENT_SAFETY_MODE=confirm
AGENT_PLATFORM=windows
AGENT_COORDINATE_WIDTH=1920
AGENT_COORDINATE_HEIGHT=1080

##################################################### Visual Analysis
VISUAL_CHANGE_THRESHOLD=15.0
OCR_CONFIDENCE_THRESHOLD=0.6

AGENT_STREAM_RESPONSES=false
AGENT_REQUEST_TIMEOUT=120